     int id;

     while (true) {

         cout << "Enter Book ID: ";

         if (cin >> id) {

               cin.ignore(

                   numeric_limits<streamsize>::max(), '\n');

               return id;

           }

           cout << "Invalid input. Please enter a number.\n";

           cin.clear();

           cin.ignore(

               numeric_limits<streamsize>::max(), '\n');

    }

}

