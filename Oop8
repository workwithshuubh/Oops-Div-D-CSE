#include <iostream>
    #include <memory>
    #include <string>
    using namespace std;

    class Shape {
    public:
        virtual void draw() const = 0;
        virtual ~Shape() = default;
    };

    class Circle : public Shape {
    public:
        void draw() const override { cout << "Drawing a Circle\n"; }
    };

    class Rectangle : public Shape {
    public:
        void draw() const override { cout << "Drawing a Rectangle\n"; }
    };

    class ShapeFactory {
    public:
        static unique_ptr<Shape> createShape(const string& type) {
            if (type == "circle") return make_unique<Circle>();
            if (type == "rectangle") return make_unique<Rectangle>();
            return nullptr;
        }
    };

    int main() {
        cout << "Name: Tilak Kaple\n";
        unique_ptr<Shape> first = ShapeFactory::createShape("circle");
        unique_ptr<Shape> second = ShapeFactory::createShape("rectangle");

        if (first) first->draw();
        if (second) second->draw();

        return 0;
    }
