#include <iostream>
    #include <string>
    using namespace std;

    class BankAccount {
    private:
        // Private members cannot be accessed directly outside this class.
        string accountNumber;
        double balance;

    public:
        // Public constructor and functions form the class interface.
        BankAccount(string number, double amount) {
            accountNumber = number;
            balance = (amount >= 0) ? amount : 0;
        }

         void deposit(double amount) {
             if (amount > 0) {
                 balance += amount;
                 cout << "Deposit successful.\n";
             } else {
                 cout << "Invalid deposit amount.\n";
             }
         }

         void display() const {
             cout << "Account: " << accountNumber
                  << ", Balance: " << balance << '\n';
         }
    };

    int main() {
        cout << "Name: Tilak Kaple\n";
         BankAccount account1("A101", 5000);
         BankAccount account2("A102", 2500);

         account1.deposit(1000);
         account1.display();
         account2.display();
         return 0;
    }
